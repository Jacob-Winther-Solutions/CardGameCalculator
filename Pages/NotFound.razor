@page "/not-found"
@layout MainLayout

<PageTitle>Page Not Found - Card Game Calculator</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16 d-flex flex-column align-center">
    <MudText Typo="Typo.h1" Color="Color.Primary">404</MudText>
    <MudText Typo="Typo.h5" GutterBottom="true">Page Not Found</MudText>
    <MudText Typo="Typo.body1" Class="mb-6" Color="Color.Secondary" Align="Align.Center">
        The page you are looking for does not exist.
    </MudText>
    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Home">
        Back to Home
    </MudButton>
</MudContainer>
