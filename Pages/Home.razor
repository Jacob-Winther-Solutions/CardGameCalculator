@page "/"

<PageTitle>Card Game Calculator</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Card Game Calculator</MudText>
<MudText Typo="Typo.subtitle1" Class="mb-8" Color="Color.Secondary">
    A collection of probability calculators for card games like Magic: The Gathering.
</MudText>

<MudGrid>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Primary">
                        <MudIcon Icon="@Icons.Material.Filled.BarChart" />
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Hypergeometric Calculator</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Drawing specific cards from a deck</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2">
                    Calculate the probability of drawing a specific number of instances of a card
                    in your opening hand or after a given number of draws.
                </MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Href="/hypergeometric" Variant="Variant.Text" Color="Color.Primary">Open Calculator</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Secondary">
                        <MudIcon Icon="@Icons.Material.Filled.Hub" />
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Combo Stability Calculator</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Joint probability across multiple card groups</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2">
                    Calculate the probability of drawing all required pieces of a multi-part combination,
                    such as a reanimator package needing targets, spells, and graveyard feeders simultaneously.
                </MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Href="/multivariate" Variant="Variant.Text" Color="Color.Secondary">Open Calculator</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Tertiary">
                        <MudIcon Icon="@Icons.Material.Filled.Shuffle" />
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Mulligan & Looting Calculator</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Assembly probability over turns with mulligans</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2">
                    Simulate the London Mulligan rule and looting effects such as Faithless Looting
                    to model how quickly a combination is assembled in a real game.
                </MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Href="/mulligan-looting" Variant="Variant.Text" Color="Color.Tertiary">Open Calculator</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Info">
                        <MudIcon Icon="@Icons.Material.Filled.Landscape" />
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Mana Base Analyzer</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Land drop probability by turn</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2">
                    Calculate the probability of hitting your land drops on curve given your deck size
                    and land count, shown turn by turn from opening hand through the late game.
                </MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Href="/mana-base" Variant="Variant.Text" Color="Color.Info">Open Calculator</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>
