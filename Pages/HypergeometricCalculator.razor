@page "/hypergeometric"

<PageTitle>Hypergeometric Calculator - Card Game Calculator</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Hypergeometric Calculator</MudText>
<MudText Typo="Typo.body1" Class="mb-6" Color="Color.Secondary">
    Calculate the probability of drawing specific cards from your deck.
</MudText>

<MudGrid>
    <MudItem xs="12" md="4">
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Parameters</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudNumericField @bind-Value="_deckSize" Label="Deck Size" Variant="Variant.Outlined"
                    Min="1" Max="999" HelperText="Total cards in your deck" Class="mb-4" />
                <MudNumericField @bind-Value="_copiesInDeck" Label="Copies in Deck" Variant="Variant.Outlined"
                    Min="0" Max="@_deckSize" HelperText="Copies of the card in your deck" Class="mb-4" />
                <MudNumericField @bind-Value="_cardsDrawn" Label="Cards Drawn" Variant="Variant.Outlined"
                    Min="1" Max="@_deckSize" HelperText="Cards drawn (e.g. opening hand size)" Class="mb-4" />
                <MudNumericField @bind-Value="_desiredCopies" Label="Desired Copies" Variant="Variant.Outlined"
                    Min="0" Max="@Math.Min(_copiesInDeck, _cardsDrawn)"
                    HelperText="How many copies you want to see" />
            </MudCardContent>
            <MudCardActions Class="flex-column px-4 pb-4 pt-0">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Calculate" FullWidth="true"
                    StartIcon="@Icons.Material.Filled.Calculate" Class="mb-2">
                    Calculate
                </MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="ResetToFormat" FullWidth="true"
                    StartIcon="@Icons.Material.Filled.RestartAlt">
                    Reset to chosen format
                </MudButton>
            </MudCardActions>
        </MudCard>

        @if (_calculated)
        {
            <MudCard Elevation="2" Class="mt-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Results</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pa-0">
                    <MudList T="string" Dense="true">
                        <MudListItem>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Exactly @_desiredCopies @CopiesLabel(_desiredCopies)</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Primary">@_exactProb.ToString("P2")</MudText>
                        </MudListItem>
                        <MudDivider />
                        <MudListItem>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">At least @_desiredCopies @CopiesLabel(_desiredCopies)</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Primary">@_atLeastProb.ToString("P2")</MudText>
                        </MudListItem>
                        <MudDivider />
                        <MudListItem>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">At most @_desiredCopies @CopiesLabel(_desiredCopies)</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Primary">@_atMostProb.ToString("P2")</MudText>
                        </MudListItem>
                    </MudList>
                </MudCardContent>
            </MudCard>
        }
        <MudCard Elevation="2" Class="mt-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Optimal Instances Advisor</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudNumericField @bind-Value="_targetProbability" Label="Target probability (%)"
                    Variant="Variant.Outlined" Min="1" Max="99" Class="mb-4"
                    HelperText="Minimum chance of drawing the desired instances" />
                <MudNumericField @bind-Value="_advisorDesiredInHand" Label="Desired in hand"
                    Variant="Variant.Outlined" Min="1" Max="@_cardsDrawn"
                    HelperText="Instances you want to see in your opening hand" />
            </MudCardContent>
            <MudCardActions Class="flex-column px-4 pb-4 pt-0">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="RunAdvisor"
                    FullWidth="true" StartIcon="@Icons.Material.Filled.Search">
                    Find Optimal Instances
                </MudButton>
            </MudCardActions>
        </MudCard>

        @if (_advisorCalculated)
        {
            <MudCard Elevation="2" Class="mt-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Advisor Results</MudText>
                        @if (_advisorMinInstances.HasValue)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Minimum @_advisorMinInstances instance@(_advisorMinInstances == 1 ? "" : "s") for &ge;@_targetProbability% drawing @_cardsDrawn cards
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Error">
                                Target not achievable within the deck.
                            </MudText>
                        }
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pa-0">
                    <MudTable Items="_advisorRows" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Instances in deck</MudTh>
                            <MudTh>Probability</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Instances</MudTd>
                            <MudTd>
                                <MudText Color="@(context.MeetsTarget ? Color.Success : Color.Inherit)">
                                    @context.Probability.ToString("P2")
                                </MudText>
                            </MudTd>
                            <MudTd>
                                @if (context.Instances == _advisorMinInstances)
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Recommended</MudChip>
                                }
                                else if (context.MeetsTarget)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        }
    </MudItem>

    <MudItem xs="12" md="8">
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Probability Distribution</MudText>
                    @if (_calculated)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Drawing from @_deckSize cards (@_copiesInDeck copies), @_cardsDrawn drawn
                        </MudText>
                    }
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @if (_calculated)
                {
                    <PlotlyChart Config="_chartConfig" Layout="_chartLayout" Data="_chartData" />
                }
                else
                {
                    <MudPaper Class="d-flex align-center justify-center" Style="height:300px;" Elevation="0">
                        <MudText Color="Color.Secondary">Press Calculate to see the distribution.</MudText>
                    </MudPaper>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>
