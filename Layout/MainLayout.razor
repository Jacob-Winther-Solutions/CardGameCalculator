@inherits LayoutComponentBase
@implements IDisposable
@inject FormatService FormatService
@inject ISnackbar Snackbar

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="DrawerToggle" />
        <MudText Typo="Typo.h6" Class="ml-3">Card Game Calculator</MudText>
        <MudSpacer />
        <MudSelect T="FormatPreset"
                   Value="FormatService.Current"
                   ValueChanged="OnFormatChanged"
                   ToStringFunc="@(f => f.Name)"
                   Dense="true"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Style="min-width: 160px; background-color: white; border-radius: 4px; --mud-palette-text-primary: rgba(0,0,0,0.87); --mud-palette-text-secondary: rgba(0,0,0,0.60);"
                   Class="mr-2">
            @foreach (var preset in FormatPreset.All)
            {
                <MudSelectItem T="FormatPreset" Value="preset">@preset.Name</MudSelectItem>
            }
        </MudSelect>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="DrawerVariant.Responsive">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6" Class="mt-1">Calculators</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-6 px-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;

    protected override async Task OnInitializedAsync()
    {
        await FormatService.Initialize();
        FormatService.Changed += StateHasChanged;
    }

    private async Task OnFormatChanged(FormatPreset preset)
    {
        await FormatService.SetFormat(preset);
        Snackbar.Add($"Switched to {preset.Name} — press Reset on a calculator to apply new defaults.", Severity.Info);
    }

    public void Dispose()
    {
        FormatService.Changed -= StateHasChanged;
    }
}
